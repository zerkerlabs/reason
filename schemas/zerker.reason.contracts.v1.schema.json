{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zerker.reason.contracts.v1.schema.json",
  "title": "Zerker Reason wire contract definitions",
  "description": "Wire-shape definitions for Reason authorization and organization-policy JSON. These schemas do not prove authorization semantics, source comprehension, or digest validity; Reason semantic validation remains authoritative.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "atom": {
      "type": "object",
      "required": ["predicate"],
      "properties": {
        "predicate": { "type": "string" },
        "arguments": { "type": "array" },
        "negated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["arguments"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["string", "integer", "boolean"]
          }
        }
      },
      "additionalProperties": false
    },
    "ontology": {
      "type": "object",
      "required": ["id", "version", "predicates"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "predicates": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/predicate" }
        }
      },
      "additionalProperties": false
    },
    "authorityPolicy": {
      "type": "object",
      "required": ["classes", "default_admit"],
      "properties": {
        "classes": { "$ref": "#/$defs/stringArray" },
        "default_admit": { "$ref": "#/$defs/stringArray" },
        "predicate_admit": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringArray" }
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "predicate", "authority", "observed_at"],
      "properties": {
        "id": { "type": "string" },
        "predicate": { "type": "string" },
        "arguments": { "type": "array" },
        "negated": { "type": "boolean" },
        "authority": { "type": "string" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "when", "then"],
      "properties": {
        "id": { "type": "string" },
        "when": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        },
        "then": { "$ref": "#/$defs/atom" }
      },
      "additionalProperties": false
    },
    "actionPolicy": {
      "type": "object",
      "required": ["schema", "ontology", "authority", "evaluation_time", "query"],
      "properties": {
        "schema": { "const": "zerker.reason.program.v2" },
        "ontology": { "$ref": "#/$defs/ontology" },
        "authority": { "$ref": "#/$defs/authorityPolicy" },
        "evaluation_time": { "$ref": "#/$defs/timestamp" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "query": { "$ref": "#/$defs/atom" }
      },
      "additionalProperties": false
    },
    "portablePolicySourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f\\u0080-\\u009f](?:[^\\\\\\u0000-\\u001f\\u007f\\u0080-\\u009f]*[^/\\\\\\u0000-\\u001f\\u007f\\u0080-\\u009f])?$",
      "allOf": [
        { "not": { "pattern": "(^|/)(\\.|\\.\\.)(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "^[^/]*:" } },
        { "not": { "pattern": "[\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]" } }
      ]
    },
    "policySource": {
      "type": "object",
      "required": ["path", "kind", "scope"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePolicySourcePath" },
        "kind": { "type": "string", "enum": ["instruction", "skill", "context"] },
        "scope": { "type": "string", "enum": ["organization", "repository", "agent"] }
      },
      "additionalProperties": false
    },
    "policySourceManifest": {
      "type": "object",
      "required": ["schema", "sources"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-source-manifest.v1" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/policySource" }
        }
      },
      "additionalProperties": false
    },
    "policyTemplate": {
      "type": "object",
      "required": ["schema", "ontology", "authority", "facts", "rules"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-template.v1" },
        "ontology": { "$ref": "#/$defs/ontology" },
        "authority": { "$ref": "#/$defs/authorityPolicy" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        }
      },
      "additionalProperties": false
    },
    "lockedPolicySource": {
      "type": "object",
      "required": ["path", "kind", "scope", "size_bytes", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePolicySourcePath" },
        "kind": { "type": "string", "enum": ["instruction", "skill", "context"] },
        "scope": { "type": "string", "enum": ["organization", "repository", "agent"] },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "policyBundle": {
      "type": "object",
      "required": ["schema", "bundle_digest", "sources", "policy"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-bundle.v1" },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/lockedPolicySource" }
        },
        "policy": { "$ref": "#/$defs/policyTemplate" }
      },
      "additionalProperties": false
    },
    "policySourceVerification": {
      "type": "object",
      "required": ["schema", "status", "policy_bundle_digest", "sources_verified"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-source-verification.v1" },
        "status": { "const": "verified" },
        "policy_bundle_digest": { "$ref": "#/$defs/digest" },
        "sources_verified": { "type": "integer", "minimum": 1, "maximum": 256 }
      },
      "additionalProperties": false
    },
    "policyAuthorizationInput": {
      "type": "object",
      "required": ["schema", "policy_bundle", "evaluation_time", "mission", "action"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-authorization-input.v1" },
        "policy_bundle": { "$ref": "#/$defs/policyBundle" },
        "evaluation_time": { "$ref": "#/$defs/timestamp" },
        "mission": { "$ref": "#/$defs/mission" },
        "action": { "$ref": "#/$defs/proposedAction" }
      },
      "additionalProperties": false
    },
    "policyAuthorization": {
      "type": "object",
      "required": ["schema", "policy_bundle_digest", "authorization_status", "request_digest", "reasoning_result_digest", "authorization"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-authorization.v1" },
        "policy_bundle_digest": { "$ref": "#/$defs/digest" },
        "authorization_status": { "$ref": "#/$defs/authorizationStatus" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "reasoning_result_digest": { "$ref": "#/$defs/digest" },
        "authorization": { "$ref": "#/$defs/authorizationBundle" }
      },
      "additionalProperties": false
    },
    "policyAuthorizationVerificationInput": {
      "type": "object",
      "required": ["schema", "policy_bundle", "policy_authorization"],
      "properties": {
        "schema": { "const": "zerker.reason.policy-authorization-verification-input.v1" },
        "policy_bundle": { "$ref": "#/$defs/policyBundle" },
        "policy_authorization": { "$ref": "#/$defs/policyAuthorization" }
      },
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "required": ["id", "principal", "instruction_digest", "issued_at"],
      "properties": {
        "id": { "type": "string" },
        "principal": { "type": "string" },
        "instruction_digest": { "$ref": "#/$defs/digest" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "constraints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "actionEffect": {
      "type": "object",
      "required": ["kind", "resource"],
      "properties": {
        "kind": { "type": "string" },
        "resource": { "type": "string" },
        "value": true
      },
      "additionalProperties": false
    },
    "proposedAction": {
      "type": "object",
      "required": ["id", "tool", "proposed_at"],
      "properties": {
        "id": { "type": "string" },
        "tool": { "type": "string" },
        "proposed_at": { "$ref": "#/$defs/timestamp" },
        "arguments": { "type": "object" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionEffect" }
        }
      },
      "additionalProperties": false
    },
    "actionRequest": {
      "type": "object",
      "required": ["schema", "mission", "action", "policy"],
      "properties": {
        "schema": { "const": "zerker.reason.action.v1" },
        "mission": { "$ref": "#/$defs/mission" },
        "action": { "$ref": "#/$defs/proposedAction" },
        "policy": { "$ref": "#/$defs/actionPolicy" }
      },
      "additionalProperties": false
    },
    "boundObject": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "boundAction": {
      "type": "object",
      "required": ["id", "digest", "tool", "arguments", "effects"],
      "properties": {
        "id": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "tool": { "type": "string" },
        "arguments": { "type": "object" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionEffect" }
        }
      },
      "additionalProperties": false
    },
    "ontologyRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "factTemporal": {
      "type": "object",
      "required": ["observed_at"],
      "properties": {
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "factProofNode": {
      "type": "object",
      "required": ["id", "kind", "atom", "source_id", "authority", "temporal", "premises"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "fact" },
        "atom": { "$ref": "#/$defs/atom" },
        "source_id": { "type": "string" },
        "authority": { "type": "string" },
        "temporal": { "$ref": "#/$defs/factTemporal" },
        "premises": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "derivationProofNode": {
      "type": "object",
      "required": ["id", "kind", "atom", "source_id", "premises"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "derivation" },
        "atom": { "$ref": "#/$defs/atom" },
        "source_id": { "type": "string" },
        "premises": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "proofNode": {
      "oneOf": [
        { "$ref": "#/$defs/factProofNode" },
        { "$ref": "#/$defs/derivationProofNode" }
      ]
    },
    "proof": {
      "type": "object",
      "required": ["root", "nodes", "digest"],
      "properties": {
        "root": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/proofNode" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "conflictWitness": {
      "type": "object",
      "required": ["query", "complement", "fact_ids", "proof_digests"],
      "properties": {
        "query": { "$ref": "#/$defs/atom" },
        "complement": { "$ref": "#/$defs/atom" },
        "fact_ids": { "$ref": "#/$defs/stringArray" },
        "proof_digests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        }
      },
      "additionalProperties": false
    },
    "withheldFact": {
      "type": "object",
      "required": ["fact_id", "atom", "authority", "admitted_authorities", "reason"],
      "properties": {
        "fact_id": { "type": "string" },
        "atom": { "$ref": "#/$defs/atom" },
        "authority": { "type": "string" },
        "admitted_authorities": { "$ref": "#/$defs/stringArray" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "authorityReport": {
      "type": "object",
      "required": ["policy_digest", "admitted_fact_ids", "withheld"],
      "properties": {
        "policy_digest": { "$ref": "#/$defs/digest" },
        "admitted_fact_ids": { "$ref": "#/$defs/stringArray" },
        "withheld": {
          "type": "array",
          "items": { "$ref": "#/$defs/withheldFact" }
        }
      },
      "additionalProperties": false
    },
    "temporallyWithheldFact": {
      "type": "object",
      "required": ["fact_id", "atom", "reason"],
      "properties": {
        "fact_id": { "type": "string" },
        "atom": { "$ref": "#/$defs/atom" },
        "reason": { "type": "string" },
        "superseded_by": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "temporalReport": {
      "type": "object",
      "required": ["evaluation_time", "eligible_fact_ids", "withheld"],
      "properties": {
        "evaluation_time": { "$ref": "#/$defs/timestamp" },
        "eligible_fact_ids": { "$ref": "#/$defs/stringArray" },
        "withheld": {
          "type": "array",
          "items": { "$ref": "#/$defs/temporallyWithheldFact" }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["facts_supplied", "facts_admitted", "facts_withheld", "facts_derived", "rules_evaluated", "rounds"],
      "properties": {
        "facts_supplied": { "type": "integer", "minimum": 0 },
        "facts_admitted": { "type": "integer", "minimum": 0 },
        "facts_withheld": { "type": "integer", "minimum": 0 },
        "facts_derived": { "type": "integer", "minimum": 0 },
        "rules_evaluated": { "type": "integer", "minimum": 0 },
        "rounds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "authorizationReasoning": {
      "type": "object",
      "required": ["schema", "status", "query", "program_digest", "ontology", "authority", "temporal", "proof", "disproof", "conflict", "missing", "assumptions", "metrics"],
      "properties": {
        "schema": { "const": "zerker.reason.result.v2" },
        "status": {
          "type": "string",
          "enum": ["proved", "disproved", "inconsistent", "unknown"]
        },
        "query": { "$ref": "#/$defs/atom" },
        "program_digest": { "$ref": "#/$defs/digest" },
        "ontology": { "$ref": "#/$defs/ontologyRef" },
        "authority": { "$ref": "#/$defs/authorityReport" },
        "temporal": { "$ref": "#/$defs/temporalReport" },
        "proof": {
          "oneOf": [
            { "$ref": "#/$defs/proof" },
            { "type": "null" }
          ]
        },
        "disproof": {
          "oneOf": [
            { "$ref": "#/$defs/proof" },
            { "type": "null" }
          ]
        },
        "conflict": {
          "oneOf": [
            { "$ref": "#/$defs/conflictWitness" },
            { "type": "null" }
          ]
        },
        "missing": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        },
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "authorizationStatus": {
      "type": "string",
      "enum": ["authorized", "denied", "conflicted", "insufficient_evidence"]
    },
    "authorizationIssue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "atom": { "$ref": "#/$defs/atom" },
        "fact_ids": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "authorizationResult": {
      "type": "object",
      "required": ["schema", "status", "request_digest", "mission", "action", "reasoning", "issues"],
      "properties": {
        "schema": { "const": "zerker.reason.authorization.v1" },
        "status": { "$ref": "#/$defs/authorizationStatus" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "mission": { "$ref": "#/$defs/boundObject" },
        "action": { "$ref": "#/$defs/boundAction" },
        "reasoning": { "$ref": "#/$defs/authorizationReasoning" },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationIssue" }
        }
      },
      "additionalProperties": false
    },
    "authorizationBundle": {
      "type": "object",
      "required": ["schema", "request", "certificate"],
      "properties": {
        "schema": { "const": "zerker.reason.authorization-bundle.v1" },
        "request": { "$ref": "#/$defs/actionRequest" },
        "certificate": { "$ref": "#/$defs/authorizationResult" }
      },
      "additionalProperties": false
    },
    "authorizationVerification": {
      "type": "object",
      "required": ["schema", "status", "authorization_status", "request_digest", "reasoning_result_digest"],
      "properties": {
        "schema": { "const": "zerker.reason.authorization-verification.v1" },
        "status": { "const": "verified" },
        "authorization_status": { "$ref": "#/$defs/authorizationStatus" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "reasoning_result_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "releaseMission": {
      "type": "object",
      "required": ["id", "principal", "instruction_digest", "issued_at"],
      "properties": {
        "id": { "type": "string" },
        "principal": { "type": "string" },
        "instruction_digest": { "$ref": "#/$defs/digest" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "releaseTarget": {
      "type": "object",
      "required": ["action_id", "tool", "version", "commit", "environment", "artifact_digest", "required_approver", "proposed_at"],
      "properties": {
        "action_id": { "type": "string" },
        "tool": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "environment": { "type": "string" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "required_approver": { "type": "string" },
        "proposed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "commitDecisionEvidence": {
      "type": "object",
      "required": ["id", "commit", "status", "authority", "observed_at"],
      "properties": {
        "id": { "type": "string" },
        "commit": { "type": "string" },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "authority": { "type": "string" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "artifactEvidence": {
      "type": "object",
      "required": ["id", "commit", "digest", "authority", "observed_at"],
      "properties": {
        "id": { "type": "string" },
        "commit": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "authority": { "type": "string" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "approvalEvidence": {
      "type": "object",
      "required": ["id", "version", "commit", "environment", "artifact_digest", "tool", "approver", "status", "authority", "observed_at"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "environment": { "type": "string" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "tool": { "type": "string" },
        "approver": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "denied"] },
        "authority": { "type": "string" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "releaseEvidence": {
      "type": "object",
      "properties": {
        "tests": { "type": "array", "items": { "$ref": "#/$defs/commitDecisionEvidence" } },
        "security_reviews": { "type": "array", "items": { "$ref": "#/$defs/commitDecisionEvidence" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactEvidence" } },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/approvalEvidence" } }
      },
      "additionalProperties": false
    },
    "releaseAuthorizationInput": {
      "type": "object",
      "required": ["schema", "evaluation_time", "mission", "release"],
      "properties": {
        "schema": { "const": "zerker.reason.release-authorization.v1" },
        "evaluation_time": { "$ref": "#/$defs/timestamp" },
        "mission": { "$ref": "#/$defs/releaseMission" },
        "release": { "$ref": "#/$defs/releaseTarget" },
