{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zerker.reason.contracts.v1.schema.json",
  "title": "Zerker Reason authorization contract definitions",
  "description": "Wire-shape definitions for Reason authorization JSON. These schemas do not prove authorization semantics; the Reason verifier remains authoritative.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "atom": {
      "type": "object",
      "required": ["predicate"],
      "properties": {
        "predicate": { "type": "string" },
        "arguments": { "type": "array" },
        "negated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["arguments"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["string", "integer", "boolean"]
          }
        }
      },
      "additionalProperties": false
    },
    "ontology": {
      "type": "object",
      "required": ["id", "version", "predicates"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "predicates": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/predicate" }
        }
      },
      "additionalProperties": false
    },
    "authorityPolicy": {
      "type": "object",
      "required": ["classes", "default_admit"],
      "properties": {
        "classes": { "$ref": "#/$defs/stringArray" },
        "default_admit": { "$ref": "#/$defs/stringArray" },
        "predicate_admit": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringArray" }
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "predicate", "authority", "observed_at"],
      "properties": {
        "id": { "type": "string" },
        "predicate": { "type": "string" },
        "arguments": { "type": "array" },
        "negated": { "type": "boolean" },
        "authority": { "type": "string" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "when", "then"],
      "properties": {
        "id": { "type": "string" },
        "when": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        },
        "then": { "$ref": "#/$defs/atom" }
      },
      "additionalProperties": false
    },
    "actionPolicy": {
      "type": "object",
      "required": ["schema", "ontology", "authority", "evaluation_time", "query"],
      "properties": {
        "schema": { "const": "zerker.reason.program.v2" },
        "ontology": { "$ref": "#/$defs/ontology" },
        "authority": { "$ref": "#/$defs/authorityPolicy" },
        "evaluation_time": { "$ref": "#/$defs/timestamp" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "query": { "$ref": "#/$defs/atom" }
      },
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "required": ["id", "principal", "instruction_digest", "issued_at"],
      "properties": {
        "id": { "type": "string" },
        "principal": { "type": "string" },
        "instruction_digest": { "$ref": "#/$defs/digest" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "constraints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "actionEffect": {
      "type": "object",
      "required": ["kind", "resource"],
      "properties": {
        "kind": { "type": "string" },
        "resource": { "type": "string" },
        "value": true
      },
      "additionalProperties": false
    },
    "proposedAction": {
      "type": "object",
      "required": ["id", "tool", "proposed_at"],
      "properties": {
        "id": { "type": "string" },
        "tool": { "type": "string" },
        "proposed_at": { "$ref": "#/$defs/timestamp" },
        "arguments": { "type": "object" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionEffect" }
        }
      },
      "additionalProperties": false
    },
    "actionRequest": {
      "type": "object",
      "required": ["schema", "mission", "action", "policy"],
      "properties": {
        "schema": { "const": "zerker.reason.action.v1" },
        "mission": { "$ref": "#/$defs/mission" },
        "action": { "$ref": "#/$defs/proposedAction" },
        "policy": { "$ref": "#/$defs/actionPolicy" }
      },
      "additionalProperties": false
    },
    "boundObject": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "boundAction": {
      "type": "object",
      "required": ["id", "digest", "tool", "arguments", "effects"],
      "properties": {
        "id": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "tool": { "type": "string" },
        "arguments": { "type": "object" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionEffect" }
        }
      },
      "additionalProperties": false
    },
    "ontologyRef": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "factTemporal": {
      "type": "object",
      "required": ["observed_at"],
      "properties": {
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "supersedes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "factProofNode": {
      "type": "object",
      "required": ["id", "kind", "atom", "source_id", "authority", "temporal", "premises"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "fact" },
        "atom": { "$ref": "#/$defs/atom" },
        "source_id": { "type": "string" },
        "authority": { "type": "string" },
        "temporal": { "$ref": "#/$defs/factTemporal" },
        "premises": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "derivationProofNode": {
      "type": "object",
      "required": ["id", "kind", "atom", "source_id", "premises"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "derivation" },
        "atom": { "$ref": "#/$defs/atom" },
        "source_id": { "type": "string" },
        "premises": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "proofNode": {
      "oneOf": [
        { "$ref": "#/$defs/factProofNode" },
        { "$ref": "#/$defs/derivationProofNode" }
      ]
    },
    "proof": {
      "type": "object",
      "required": ["root", "nodes", "digest"],
      "properties": {
        "root": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/proofNode" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "conflictWitness": {
      "type": "object",
      "required": ["query", "complement", "fact_ids", "proof_digests"],
      "properties": {
        "query": { "$ref": "#/$defs/atom" },
        "complement": { "$ref": "#/$defs/atom" },
        "fact_ids": { "$ref": "#/$defs/stringArray" },
        "proof_digests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        }
      },
      "additionalProperties": false
    },
    "withheldFact": {
      "type": "object",
      "required": ["fact_id", "atom", "authority", "admitted_authorities", "reason"],
      "properties": {
        "fact_id": { "type": "string" },
        "atom": { "$ref": "#/$defs/atom" },
        "authority": { "type": "string" },
        "admitted_authorities": { "$ref": "#/$defs/stringArray" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "authorityReport": {
      "type": "object",
      "required": ["policy_digest", "admitted_fact_ids", "withheld"],
      "properties": {
        "policy_digest": { "$ref": "#/$defs/digest" },
        "admitted_fact_ids": { "$ref": "#/$defs/stringArray" },
        "withheld": {
          "type": "array",
          "items": { "$ref": "#/$defs/withheldFact" }
        }
      },
      "additionalProperties": false
    },
    "temporallyWithheldFact": {
      "type": "object",
      "required": ["fact_id", "atom", "reason"],
      "properties": {
        "fact_id": { "type": "string" },
        "atom": { "$ref": "#/$defs/atom" },
        "reason": { "type": "string" },
        "superseded_by": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "temporalReport": {
      "type": "object",
      "required": ["evaluation_time", "eligible_fact_ids", "withheld"],
      "properties": {
        "evaluation_time": { "$ref": "#/$defs/timestamp" },
        "eligible_fact_ids": { "$ref": "#/$defs/stringArray" },
        "withheld": {
          "type": "array",
          "items": { "$ref": "#/$defs/temporallyWithheldFact" }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["facts_supplied", "facts_admitted", "facts_withheld", "facts_derived", "rules_evaluated", "rounds"],
      "properties": {
        "facts_supplied": { "type": "integer", "minimum": 0 },
        "facts_admitted": { "type": "integer", "minimum": 0 },
        "facts_withheld": { "type": "integer", "minimum": 0 },
        "facts_derived": { "type": "integer", "minimum": 0 },
        "rules_evaluated": { "type": "integer", "minimum": 0 },
        "rounds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "authorizationReasoning": {
      "type": "object",
      "required": ["schema", "status", "query", "program_digest", "ontology", "authority", "temporal", "proof", "disproof", "conflict", "missing", "assumptions", "metrics"],
      "properties": {
        "schema": { "const": "zerker.reason.result.v2" },
        "status": {
          "type": "string",
          "enum": ["proved", "disproved", "inconsistent", "unknown"]
        },
        "query": { "$ref": "#/$defs/atom" },
        "program_digest": { "$ref": "#/$defs/digest" },
        "ontology": { "$ref": "#/$defs/ontologyRef" },
        "authority": { "$ref": "#/$defs/authorityReport" },
        "temporal": { "$ref": "#/$defs/temporalReport" },
        "proof": {
          "oneOf": [
            { "$ref": "#/$defs/proof" },
            { "type": "null" }
          ]
        },
        "disproof": {
          "oneOf": [
            { "$ref": "#/$defs/proof" },
            { "type": "null" }
          ]
        },
        "conflict": {
          "oneOf": [
            { "$ref": "#/$defs/conflictWitness" },
            { "type": "null" }
          ]
        },
        "missing": {
          "type": "array",
          "items": { "$ref": "#/$defs/atom" }
        },
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "authorizationStatus": {
      "type": "string",
      "enum": ["authorized", "denied", "conflicted", "insufficient_evidence"]
    },
    "authorizationIssue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "atom": { "$ref": "#/$defs/atom" },
        "fact_ids": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "authorizationResult": {
      "type": "object",
      "required": ["schema", "status", "request_digest", "mission", "action", "reasoning", "issues"],
      "properties": {
        "schema": { "const": "zerker.reason.authorization.v1" },
        "status": { "$ref": "#/$defs/authorizationStatus" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "mission": { "$ref": "#/$defs/boundObject" },
        "action": { "$ref": "#/$defs/boundAction" },
        "reasoning": { "$ref": "#/$defs/authorizationReasoning" },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationIssue" }
        }
      },
      "additionalProperties": false
    },
    "authorizationBundle": {
      "type": "object",
      "required": ["schema", "request", "certificate"],
      "properties": {
        "schema": { "const": "zerker.reason.authorization-bundle.v1" },
        "request": { "$ref": "#/$defs/actionRequest" },
        "certificate": { "$ref": "#/$defs/authorizationResult" }
      },
      "additionalProperties": false
    },
    "authorizationVerification": {
      "type": "object",
      "required": ["schema", "status", "authorization_status", "request_digest", "reasoning_result_digest"],
      "properties": {
        "schema": { "const": "zerker.reason.authorization-verification.v1" },
        "status": { "const": "verified" },
        "authorization_status": { "$ref": "#/$defs/authorizationStatus" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "reasoning_result_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["schema", "status", "error"],
      "properties": {
        "schema": { "const": "zerker.reason.error.v1" },
        "status": { "const": "error" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
